POSTGRES_PASSWORD=
# Password recovery uses Gmail HTTPS API with OAuth (see docs/account-access.md).
# For local runs, export these variables in the server process as well.
MARGO_GMAIL_CLIENT_ID=
MARGO_GMAIL_CLIENT_SECRET=
MARGO_GMAIL_REFRESH_TOKEN=
MARGO_MAIL_FROM=
# Required when using docker-compose.vps.yml. Use a hostname without https://.
# API_DOMAIN=api.example.com
# Set a real project URL or contact email to enable daily Wikimedia replenishment.
# WIKIMEDIA_USER_AGENT=MARGO/0.3 (https://your-project.example/contact)
MARGO_CATALOG_AUTO_REFILL=true
MARGO_CATALOG_LOW_WATERMARK=60
MARGO_CATALOG_BATCH=20
MARGO_CATALOG_BUDGET=100
# VPS: daily PostgreSQL dump + restore into an isolated instance; 14-day retention.
MARGO_VERIFY_PASSWORD=
MARGO_BACKUP_DIR=./backups
MARGO_BACKUP_RETENTION_DAYS=14
# Default probe: https://${API_DOMAIN}/health
# MARGO_MONITOR_URL=https://api.example.com/health
# Configure one destination. Webhook receives {"text": "MARGO ALERT ..."}.
MARGO_ALERT_WEBHOOK_URL=
MARGO_ALERT_TELEGRAM_TOKEN=
MARGO_ALERT_TELEGRAM_CHAT_ID=
